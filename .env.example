# Powers all /api/ai/* routes (Copilot, vision reads, review).
# Priority order (see lib/ai/client.ts resolveProvider): this key -> GEMINI_API_KEY
# below -> AWS Bedrock. Set any ONE of them and every fabricator using the
# deployed app gets AI features with zero setup of their own.
ANTHROPIC_API_KEY=

# Optional — overrides the default model for vision/extraction routes (see lib/ai/client.ts).
# FABRIQ_AI_MODEL=claude-opus-5

# Recommended free-tier alternative: a Google AI Studio key (aistudio.google.com
# -> Get API key, starts with "AIza"). Used automatically whenever
# ANTHROPIC_API_KEY is not set. The same key also works if pasted straight into
# the app's own Settings screen — the app tells Anthropic and Gemini keys apart
# by their shape, no provider picker needed.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Alternative: AWS Bedrock (Claude via AWS). Requires an IAM user with the
# AmazonBedrockFullAccess policy and Claude model access granted in the Bedrock
# console. Used automatically when neither key above is set.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
