# Powers all /api/ai/* routes (Copilot, vision reads, review). Set this OR the
# AWS Bedrock vars below (Bedrock is used automatically when this is absent).
ANTHROPIC_API_KEY=

# Optional — overrides the default model for vision/extraction routes (see lib/ai/client.ts).
# FABRIQ_AI_MODEL=claude-opus-5

# Alternative to ANTHROPIC_API_KEY: AWS Bedrock (Claude via AWS). Requires an IAM
# user with the AmazonBedrockFullAccess policy and Claude model access granted
# in the Bedrock console. Used automatically when ANTHROPIC_API_KEY is not set.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
